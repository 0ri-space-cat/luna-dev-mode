extends SceneTree
const Access = preload("res://scripts/2d/hack_access_policy.gd")
const Profiles = preload("res://scripts/2d/character_ui_profile.gd")
const Session = preload("res://scripts/2d/hack_session_2d.gd")
func _initialize() -> void:
	var game = Session.new()
	assert(not game.can_edit("color"))
	assert(not Access.can_perform(game.wand, "COPY"))
	game.touch_rift()
	assert(game.can_edit("color"))
	assert(not game.can_edit("ai_enabled"))
	assert(not game.upgrade_original())
	assert(game.copy_wand())
	assert(not game.copy_wand())
	assert(game.upgrade_original())
	assert(game.can_edit("ai_enabled"))
	assert(Access.can_perform(game.wand, "EDIT_PORTAL"))
	var false_copy := {"id": "other", "origin_id": "luna_wand", "copied_from": "another"}
	assert(not Access.duplicate_unlock(game.wand, false_copy)["ok"])
	assert(game.collect_oracle_eye())
	assert(game.machine_label("health", "HEALTH") == "HEALTH")
	game.oracle_eye_equipped = false
	assert(game.machine_label("health", "HEALTH") != "HEALTH")
	var data: Dictionary = game.export_data()
	var restore = Session.new()
	assert(restore.import_data(data))
	assert(restore.can_edit("ai_enabled"))
	assert(not restore.import_data({"wand": {}}))
	assert(Profiles.get_profile("luna")["title"] != Profiles.get_profile("yuki")["title"])
	print("2D session / wand permissions: PASS")
	quit()
