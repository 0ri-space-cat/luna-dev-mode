; Experimental standalone 2D runtime scaffold (NOT the rejected old 3D graybox or puppet-style 2D prototype).
config_version=5

[application]

config/name="LUNA: DEV MODE"
run/main_scene="res://scenes/runtime2d/sandbox.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.14, 0.12, 0.21, 1)
