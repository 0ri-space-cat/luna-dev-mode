static func resolve(elements: Array) -> String:
	if elements.is_empty() or elements.size() > 3:
		return ""
	var parts: Array[String] = []
	for value in elements:
		if not value is String or value not in ELEMENTS or value in parts:
			return ""
		parts.append(value)
	parts.sort()
	return RECIPES.get("+".join(parts), "")
