extends RefCounted
## Strict data-to-Entity adapter for level authors. No characters, story,
## scripts, sprites or map coordinates are generated by this module.
const Actor = preload("res://scripts/runtime2d/actor_body_2d.gd")

const ABILITIES := ["FLY", "SWIM", "CLIMB", "GLOW", "REGENERATION", "FIRE_BREATH", "FROST", "INK", "SPLASH", "STORM", "BLINK", "PURR", "BOUNCE", "AIR_STEP", "CRYSTAL", "SUPERPOSITION"]

const MAX_FIELDS := 8
const MAX_NAME_LENGTH := 96


static func create_actor(definition: Dictionary, location_id: String, parameter_registry) -> CharacterBody2D:
	var allowed := ["id", "category", "label", "position", "parameters", "roles", "tags", "components"]
	if definition.size() > MAX_FIELDS:
		return null
	for key in definition:
		if str(key) not in allowed:
			return null
	var identity := str(definition.get("id", ""))
	var category := str(definition.get("category", ""))
	var label := str(definition.get("label", ""))
	if identity == "luna" or not _valid_identifier(identity) or not _valid_identifier(category):
		return null
	if label.is_empty() or label.length() > MAX_NAME_LENGTH:
		return null
	if not _valid_identifier(location_id):
		return null
	var coord: Variant = definition.get("position", null)
	if not (coord is Array) or coord.size() != 2:
		return null
	for value in coord:
		if typeof(value) not in [TYPE_INT, TYPE_FLOAT] or not is_finite(float(value)) or absf(float(value)) > 100000.0:
			return null
	var params: Variant = definition.get("parameters", {})
	var components: Variant = definition.get("components", {})
	if not (params is Dictionary) or params.size() > 24 or not (components is Dictionary):
		return null
	# The runtime must never claim a future ability works merely because
	# another model added its identifier to a JSON manifest.
	if components.has("ABILITY_SET"):
		var abilities: Variant = components["ABILITY_SET"]
		if not (abilities is Dictionary) or not (abilities.get("ids", []) is Array):
			return null
		for ability_id in abilities.get("ids", []):
			if str(ability_id) not in ABILITIES:
				return null
	var state := {
		"id": identity, "category": category, "label": label,
		"location_id": location_id, "position": coord,
		"parameters": params, "components": components,
		"roles": definition.get("roles", []), "tags": definition.get("tags", []),
		"player": false
	}
	var actor = Actor.new()
	if not actor.load_snapshot(state, parameter_registry):
		actor.free()
		return null
	return actor


static func _valid_identifier(value: String) -> bool:
	return not value.is_empty() and value.length() <= 96 and value.is_valid_identifier()
